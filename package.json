{
  "name": "waver-app",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.waver.player",
    "productName": "Waver",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Waver"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3",
          "wav",
          "flac",
          "m4a",
          "aac",
          "ogg",
          "opus"
        ],
        "name": "Audio File",
        "role": "Viewer"
      }
    ]
  }
}